rules_version = '2';
// Her kullanıcı yalnız kendi belgesini (users/{uid}) okuyup yazabilir ve silebilir.
// Belge: { s: ilerleme JSON metni, t: yazma zamanı (ms), xp: toplam XP, p: bildirim aboneliği JSON (boş = kapalı),
//          ps: son hatırlatma günü (yalnız sunucu yazar) }.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['s', 't', 'xp', 'p', 'ps'])
        && (!('p' in request.resource.data) || (request.resource.data.p is string && request.resource.data.p.size() < 4000))
        && (!('ps' in request.resource.data) || request.resource.data.ps == resource.data.ps)
        && request.resource.data.s is string && request.resource.data.s.size() < 200000
        && request.resource.data.t is int && request.resource.data.xp is int;
    }
  }
}
